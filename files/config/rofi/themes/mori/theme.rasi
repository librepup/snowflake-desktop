* {
    font: "DejaVu Sans Mono 13";
    background:     #1d1f21;
    background-alt: #1d1f21;
    foreground:     #FFFFFF;
    selected:       #f22f72;
    active:         #f22f72;
    urgent:         #9A4235;
    border:         #f22f72;
    indicator-bg:   #f22f72;
    gradient:       #F56D9C;
}
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       35%;
    height:                      30%;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               9px;
    border-color:                #f22f72;
    cursor:                      "default";
    background-image:            url("/home/puppy/.config/rofi/themes/mori/background.png", none);
}
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     4px;
    border:                      0px solid;
    border-radius:               8px 8px 8px 8px;
    border-color:                #f22f72;
    background-color:            transparent;
    children:                    [ "inputbar", "message", "listview" ];
}
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               7px;
    border-color:                #1d1f21;
    background-color:            #1d1f2150;
    text-color:                  #FFFFFF;
    height:                      10px;
    orientation:                 vertical;
    children:                    [ "textbox-prompt-colon", "entry"];
}
prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-prompt-colon {
    enabled:                     true;
    padding:                     0px 0px;
    expand:                      false;
    str:                         "";
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    padding:                     5px 10px;
    background-color:            #1d1f2150;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           #FFFFFF90;
}
num-filtered-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
textbox-num-sep {
    enabled:                     true;
    expand:                      false;
    str:                         "/";
    background-color:            inherit;
    text-color:                  inherit;
}
num-rows {
    enabled:                     true;
    expand:                      false;
    background-color:            inherit;
    text-color:                  inherit;
}
case-indicator {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    margin:                      0px;
    padding:                     4px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                #f22f72;
    background-color:            transparent;
    text-color:                  #FFFFFF90;
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px ;
    handle-color:                #f22f72;
    border-radius:               8px;
    background-color:            #1d1f21;
}
element {
    enabled:                     true;
    spacing:                     1px;
    margin:                      5px;
    padding:                     5px 10px;
    border:                      0px solid;
    border-radius:               6px;
    border-color:                #f22f72;
    background-color:            transparent;
    text-color:                  #FFFFFF90;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            #1d1f2150;
    text-color:                  #FFFFFF90;
}
element normal.urgent {
    background-color:            #9A423550;
    text-color:                  #1d1f21;
}
element normal.active {
    background-color:            #f22f7250;
    text-color:                  #FFFFFF90;
}
element selected.normal {
    background-color:            #f22f7250;
    text-color:                  #FFFFFF;
}
element selected.urgent {
    background-color:            #9A423550;
    text-color:                  #1d1f21;
}
element selected.active {
    background-color:            #1d1f2150;
    text-color:                  #FFFFFF;
}
element alternate.normal {
    background-color:            #1d1f2150;
    text-color:                  #FFFFFF90;
}
element alternate.urgent {
    background-color:            #9A423550;
    text-color:                  #1d1f21;
}
element alternate.active {
    background-color:            #f22f7250;
    text-color:                  #FFFFFF;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
mode-switcher{
    enabled:                     false;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                #f22f72;
    background-color:            transparent;
    text-color:                  #FFFFFF;
}
button {
    padding:                     5px 10px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                #f22f72;
    background-color:            #1d1f21;
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            #f22f72;
    text-color:                  #1d1f21;
}
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                #f22f72;
    background-color:            transparent;
    text-color:                  #FFFFFF;
}
textbox {
    padding:                     8px 10px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                #f22f72;
    background-color:            #1d1f21;
    text-color:                  #FFFFFF;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           #FFFFFF;
    blink:                       true;
    markup:                      true;
}
error-message {
    padding:                     10px;
    border:                      2px solid;
    border-radius:               10px;
    border-color:                #f22f72;
    background-color:            #1d1f21;
    text-color:                  #FFFFFF;
}
